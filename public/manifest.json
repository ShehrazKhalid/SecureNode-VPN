{
  "manifest_version": 3,
  "name": "Sci-Fi VPN",
  "version": "1.0",
  "description": "A secure, lightning-fast VPN with a sleek Sci-Fi interface.",
  "permissions": [
    "proxy",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Sci-Fi VPN"
  }
}
