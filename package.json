{
  "name": "secure-node-vpn",
  "version": "1.0.0",
  "private": true,
  "description": "High-Performance Dynamic Proxy VPN Chrome Extension with Automated Failover & Geo-Routing Backend Daemon",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "backend": "node vpn_backend.cjs",
    "local-proxy": "node local_proxy.cjs",
    "bundle:backend": "esbuild vpn_backend.cjs --bundle --platform=node --outfile=vpn_backend_bundled.cjs",
    "build:exe": "pkg vpn_backend_bundled.cjs --target node18-win-x64 --output SciFi_VPN_Backend.exe",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "geoip-lite": "^2.0.3",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^1.24.0",
    "node-fetch": "^2.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "oxlint": "^1.71.0",
    "pkg": "^5.8.1",
    "vite": "^8.1.1"
  }
}
